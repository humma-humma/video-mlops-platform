FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.8.0 torchvision==0.23.0 --index-url https://download.pytorch.org/whl/cu126
COPY requirements-service.txt requirements-gpu-worker.txt ./
RUN pip install --no-cache-dir -r requirements-gpu-worker.txt
RUN python -c "from torchcodec.decoders import VideoDecoder; print('TorchCodec/FFmpeg import passed')"
RUN useradd --uid 10001 --create-home app
COPY src ./src
ENV PYTHONPATH=/app VIDEO_REQUIRE_TORCHCODEC=1
USER app
CMD ["celery", "-A", "src.service.tasks", "worker", "--loglevel=INFO", "--concurrency=1"]
